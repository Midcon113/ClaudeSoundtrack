<Window x:Class="ClaudeSoundtrack.App.Dialogs.ManualTagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit tags"
        Height="760" Width="1080"
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WorkshopBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource RivetedPanel}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Edit tags" Style="{StaticResource PanelTitleText}" />
                <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                           Text="Correct anything the readiness check flagged. Changes are written straight into the FLAC files." />
            </StackPanel>
        </Border>

        <!-- Album-wide fields, applied to every track at once. -->
        <Border Grid.Row="1" Style="{StaticResource RivetedPanel}" Margin="0,16,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Album title" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Album artist" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Year" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Genre" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />

                <TextBox Grid.Row="1" Grid.Column="0" x:Name="AlbumTitleBox" Style="{StaticResource PanelTextBox}" />
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="AlbumArtistBox" Style="{StaticResource PanelTextBox}" />
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="YearBox" Style="{StaticResource PanelTextBox}" />
                <TextBox Grid.Row="1" Grid.Column="6" x:Name="GenreBox" Style="{StaticResource PanelTextBox}" />
            </Grid>
        </Border>

        <!-- Track grid. Title and artist are editable in place. -->
        <Border Grid.Row="2" Style="{StaticResource RivetedPanel}" Margin="0,16,0,0" Padding="6">
            <DataGrid x:Name="TrackGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#241D18"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#1E1815"
                      Foreground="{StaticResource ParchmentBrush}"
                      FontFamily="{StaticResource BodyFont}"
                      FontSize="13"
                      SelectionMode="Single">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BrassButtonBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource BrassPaleBrush}" />
                        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="9,8" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrassDarkBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#4A3A18" />
                                <Setter Property="Foreground" Value="{StaticResource AmberBrightBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding FlatTrackNumber}" Width="46" IsReadOnly="True" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                    <DataGridTextColumn Header="From" Binding="{Binding SourceText}" Width="96" IsReadOnly="True" />
                    <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="File" Binding="{Binding FileNameText}" Width="220" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource RecessedPanel}" Margin="0,14,0,0" Padding="14,10">
            <TextBlock x:Name="HintText" Style="{StaticResource DimText}"
                       Text="Editing a title also renames its file, with the track number left out as required." />
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StripNumbersButton" Content="Strip Track Numbers"
                        Style="{StaticResource BrassButton}" Margin="0,0,10,0" MinWidth="0" Padding="14,9"
                        Click="StripNumbersButton_Click" />
                <Button x:Name="CloseButton" Content="Close"
                        Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                        Click="CloseButton_Click" />
                <Button x:Name="SaveButton" Content="Save All"
                        Style="{StaticResource AmberButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
