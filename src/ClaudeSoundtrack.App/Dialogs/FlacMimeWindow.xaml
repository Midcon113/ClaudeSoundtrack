<local:PanelWindow x:Class="ClaudeSoundtrack.App.Dialogs.FlacMimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSoundtrack.App"
        Title="FLAC file type"
        CaptionHeight="66"
        Height="560" Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WorkshopBrush}"
        FontFamily="{StaticResource BodyFont}">

  <Border Style="{StaticResource ChassisEdge}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Amber, not red: this is worth knowing, not a fault in the album. -->
        <Border Grid.Row="0" Style="{StaticResource RivetedPanel}" Padding="20,14,10,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource BrassEdgeBrush}" StrokeThickness="2.5"
                             Fill="{StaticResource RecessBrush}" />
                    <Ellipse Width="16" Height="16" Fill="{StaticResource AmberBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="16"
                                              ShadowDepth="0" Opacity="0.95" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Windows has the wrong type for FLAC"
                               Style="{StaticResource PanelTitleText}" FontSize="19" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource DimText}" Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Style="{StaticResource CloseCaptionButton}"
                        AutomationProperties.Name="Close"
                        VerticalAlignment="Top" Margin="0,-4,0,0"
                        Click="LaterButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource RivetedPanel}" Margin="0,14,0,0" Padding="22,18">
            <StackPanel>
                <Border Style="{StaticResource RecessedPanel}" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Registered as" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />
                        <TextBlock x:Name="CurrentText" Style="{StaticResource ReadoutText}" />
                        <TextBlock Text="Should be" Style="{StaticResource PlateLabelText}" Margin="0,12,0,6" />
                        <TextBlock Text="audio/flac" Style="{StaticResource ReadoutText}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10"
                           Text="Firefox asks Windows what type a file is, so your FLACs arrive at YouTube Music claiming to be something else. Its uploader checks the type in the browser and rejects every track — with no error in the network log, because nothing is ever sent." />

                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10"
                           Text="Chrome carries its own list and ignores Windows, which is why the same upload works there." />

                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                           Text="Fixing this writes one value under HKEY_CURRENT_USER — your account only, no administrator rights, and nothing else is touched. It changes what the type is called, not which program opens FLAC files. Restart Firefox afterwards, as it caches this." />

                <CheckBox x:Name="DontAskCheck" Style="{StaticResource PanelCheckBox}"
                          Content="Don't check this again" Margin="0,18,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource DimText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Not Now" Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                        Click="LaterButton_Click" />
                <Button x:Name="FixButton" Content="Fix It" Style="{StaticResource AmberButton}"
                        Click="FixButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
  </Border>
</local:PanelWindow>
