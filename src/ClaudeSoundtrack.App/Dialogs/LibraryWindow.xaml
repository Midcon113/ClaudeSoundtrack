<local:PanelWindow x:Class="ClaudeSoundtrack.App.Dialogs.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSoundtrack.App"
        xmlns:controls="clr-namespace:ClaudeSoundtrack.App.Controls"
        Title="Library"
        CaptionHeight="76"
        Height="820" Width="1240"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WorkshopBrush}"
        FontFamily="{StaticResource BodyFont}">

  <Border Style="{StaticResource ChassisEdge}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Caption strip -->
        <Border Grid.Row="0" Style="{StaticResource RivetedPanel}" Padding="20,12,10,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Library" Style="{StaticResource PanelTitleText}" />
                    <TextBlock x:Name="LibraryPathText" Style="{StaticResource DimText}" Margin="0,2,0,0" />
                </StackPanel>

                <controls:LampBank Grid.Column="1"
                                   LampCount="7" LampSize="10"
                                   LampColor="{StaticResource LampGreenColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,-4,0,0">
                    <Button Content="Rescan" Style="{StaticResource CaptionButton}" Width="66"
                            AutomationProperties.Name="Rescan"
                            Click="RescanButton_Click" />
                    <Button Content="✕" Style="{StaticResource CloseCaptionButton}"
                            AutomationProperties.Name="Close"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Albums on the left, tracks on the right -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource RivetedPanel}" Padding="6">
                <Grid>
                    <ListBox x:Name="AlbumList"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="AlbumList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card"
                                                    Background="{StaticResource SteelBrush}"
                                                    BorderBrush="{StaticResource BrassDarkBrush}"
                                                    BorderThickness="1.5" CornerRadius="3" Padding="8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                    <Setter TargetName="Card" Property="Background" Value="#3A2E14" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{StaticResource BrassDarkBrush}" BorderThickness="1"
                                            Width="58" Height="58" Background="{StaticResource RecessBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource ParchmentBrush}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource ParchmentDimBrush}"
                                                   FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource ParchmentFaintBrush}"
                                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyLibraryText"
                               Style="{StaticResource DimText}"
                               Visibility="Collapsed"
                               TextAlignment="Center"
                               VerticalAlignment="Center" Margin="20"
                               Text="No albums found yet. Rip a disc and it will appear here." />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource RivetedPanel}" Margin="14,0,0,0" Padding="6">
                <ListView x:Name="TrackList"
                          Style="{StaticResource PanelListView}"
                          ItemContainerStyle="{StaticResource PanelListViewItem}"
                          MouseDoubleClick="TrackList_MouseDoubleClick">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource PanelGridViewHeader}">
                            <GridViewColumn Header="" Width="34" DisplayMemberBinding="{Binding NowPlayingMark}" />
                            <GridViewColumn Header="#" Width="46" DisplayMemberBinding="{Binding TrackNumber}" />
                            <GridViewColumn Header="Title" Width="470" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Artist" Width="230" DisplayMemberBinding="{Binding Artist}" />
                            <GridViewColumn Header="Length" Width="80" DisplayMemberBinding="{Binding DurationText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- Transport -->
        <Border Grid.Row="2" Style="{StaticResource RivetedPanel}" Margin="0,14,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Now-playing art -->
                <Border Grid.Column="0" Width="56" Height="56"
                        BorderBrush="{StaticResource BrassEdgeBrush}" BorderThickness="1.5"
                        Background="{StaticResource RecessBrush}">
                    <Image x:Name="NowPlayingArt" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="PrevButton" Content="⏮" FontSize="16"
                            Style="{StaticResource BrassButton}" MinWidth="0" Padding="12,7"
                            AutomationProperties.Name="Previous track"
                            Click="PrevButton_Click" />
                    <Button x:Name="PlayPauseButton" Content="▶" FontSize="16"
                            Style="{StaticResource AmberButton}" MinWidth="0" Padding="16,7" Margin="8,0"
                            AutomationProperties.Name="Play"
                            Click="PlayPauseButton_Click" />
                    <Button x:Name="NextButton" Content="⏭" FontSize="16"
                            Style="{StaticResource BrassButton}" MinWidth="0" Padding="12,7"
                            AutomationProperties.Name="Next track"
                            Click="NextButton_Click" />
                    <Button x:Name="StopButton" Content="⏹" FontSize="16"
                            Style="{StaticResource BrassButton}" MinWidth="0" Padding="12,7" Margin="8,0,0,0"
                            AutomationProperties.Name="Stop"
                            Click="StopButton_Click" />
                </StackPanel>

                <Grid Grid.Column="2" Margin="20,0,20,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock x:Name="NowPlayingText" Style="{StaticResource ReadoutText}"
                                   Text="Nothing playing" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TimeText" Style="{StaticResource DimText}"
                                   HorizontalAlignment="Right" Text="" />
                    </Grid>
                    <Slider Grid.Row="1" x:Name="SeekSlider" Minimum="0" Maximum="1"
                            AutomationProperties.Name="Seek"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp" />
                </Grid>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="130">
                    <TextBlock Text="Volume" Style="{StaticResource PlateLabelText}" Margin="0,0,0,2" />
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.7"
                            AutomationProperties.Name="Volume"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
  </Border>
</local:PanelWindow>
