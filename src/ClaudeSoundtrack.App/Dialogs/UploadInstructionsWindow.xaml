<local:PanelWindow x:Class="ClaudeSoundtrack.App.Dialogs.UploadInstructionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSoundtrack.App"
        Title="Ready to upload"
        CaptionHeight="90"
        Height="600" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WorkshopBrush}"
        FontFamily="{StaticResource BodyFont}">

  <Border Style="{StaticResource ChassisEdge}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The all-clear lamp, lit green. -->
        <Border Grid.Row="0" Style="{StaticResource RivetedPanel}" Padding="22,18,10,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Closing the window means "not ready", same as the Edit button. -->
              <Button Grid.Column="1" Content="✕"
                      Style="{StaticResource CloseCaptionButton}"
                      AutomationProperties.Name="Close"
                      VerticalAlignment="Top" Margin="0,-8,0,0"
                      Click="EditButton_Click" />
            <StackPanel Orientation="Horizontal">
                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource BrassEdgeBrush}" StrokeThickness="3" Fill="{StaticResource RecessBrush}" />
                    <Ellipse Width="22" Height="22" Fill="{StaticResource LampGreenBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource LampGreenColor}" BlurRadius="22" ShadowDepth="0" Opacity="1" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ready to upload" Style="{StaticResource PanelTitleText}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource DimText}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource RecessedPanel}" Margin="0,16,0,0" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Album folder" Style="{StaticResource PlateLabelText}" Margin="0,0,0,7" />
                <TextBlock x:Name="FolderText" Style="{StaticResource ReadoutText}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource RivetedPanel}" Margin="0,16,0,0" Padding="22,18">
            <StackPanel>
                <TextBlock Text="To upload" Style="{StaticResource PlateLabelText}" Margin="0,0,0,14" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Text="1" Style="{StaticResource ReadoutText}" Width="24" />
                    <TextBlock Style="{StaticResource BodyText}" Width="560"
                               Text="Open music.youtube.com and sign in." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Text="2" Style="{StaticResource ReadoutText}" Width="24" />
                    <TextBlock Style="{StaticResource BodyText}" Width="560"
                               Text="Click your profile picture, then Upload music." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Text="3" Style="{StaticResource ReadoutText}" Width="24" />
                    <TextBlock Style="{StaticResource BodyText}" Width="560"
                               Text="Click OK below. The album folder opens in Explorer." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <TextBlock Text="4" Style="{StaticResource ReadoutText}" Width="24" />
                    <TextBlock Style="{StaticResource BodyText}" Width="560"
                               Text="Select every FLAC file and drag them onto the upload page in one go. Uploading them together is what keeps them as a single album." />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="5" Style="{StaticResource ReadoutText}" Width="24" />
                    <TextBlock Style="{StaticResource BodyText}" Width="560"
                               Text="Give it a few minutes to process. The album appears under Library, Albums." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource DimText}" VerticalAlignment="Center"
                       Text="Not convinced it is ready? Go back to the tag editor." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EditButton" Content="Not Ready - Edit"
                        Style="{StaticResource BrassButton}" Margin="0,0,10,0" MinWidth="0" Padding="14,9"
                        Click="EditButton_Click" />
                <Button x:Name="OkButton" Content="OK - Open Folder"
                        Style="{StaticResource AmberButton}"
                        IsDefault="True"
                        Click="OkButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
  </Border>
</local:PanelWindow>
