<local:PanelWindow x:Class="ClaudeSoundtrack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSoundtrack.App"
        xmlns:controls="clr-namespace:ClaudeSoundtrack.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClaudeSoundtrack"
        Height="820" Width="1240"
        MinHeight="680" MinWidth="1040"
        CaptionHeight="76"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WorkshopBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <!--
            The stage lamp used down the left rail. Three states, matching the
            reference panels: unlit (pending), amber (active), green (done).
        -->
        <Style x:Key="StageLamp" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="#1A1512" />
            <Setter Property="Stroke" Value="{StaticResource BrassDarkBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StageLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource ParchmentFaintBrush}" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

  <Border Style="{StaticResource ChassisEdge}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Header nameplate (also the window's caption strip) ============ -->
        <Border Grid.Row="0" Style="{StaticResource RivetedPanel}" Padding="20,12,10,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Rivets at the plate corners. -->
                <Ellipse Grid.Column="0" Style="{StaticResource Rivet}"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,-6,0,0" />
                <Ellipse Grid.Column="2" Style="{StaticResource Rivet}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-10,0" />

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- A brass disc, standing in for the CD in the drive. -->
                    <Grid Width="44" Height="44" Margin="0,0,16,0">
                        <Ellipse Stroke="{StaticResource BrassEdgeBrush}" StrokeThickness="2.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Color="#3A2E14" Offset="0" />
                                    <GradientStop Color="#1A1510" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="13" Height="13" Fill="{StaticResource SteelDarkestBrush}"
                                 Stroke="{StaticResource BrassBrush}" StrokeThickness="1.5" />
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ClaudeSoundtrack" Style="{StaticResource PanelTitleText}" />
                        <TextBlock Text="Multi-disc soundtrack ripper and YouTube Music prep"
                                   Style="{StaticResource DimText}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!--
                    The activity bank. Idle it is dark; while a rip runs the sweep
                    says "still alive" from across the room, which a percentage
                    that moves once a minute does not.
                -->
                <controls:LampBank Grid.Column="1"
                                   LampCount="9" LampSize="11"
                                   LampColor="{StaticResource AmberColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="24,0" />

                <!-- Live disc/track readout, like a panel meter. -->
                <Border Grid.Column="2" Style="{StaticResource RecessedPanel}" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="HeaderAlbumText" Style="{StaticResource ReadoutText}"
                                   Text="NO DISC" HorizontalAlignment="Right" />
                        <TextBlock x:Name="HeaderDetailText" Style="{StaticResource DimText}"
                                   Text="Insert a disc to begin" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Window furniture. Kept flat so it does not compete with the panel controls. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Top" Margin="14,-4,0,0">
                    <Button x:Name="SettingsButton" AutomationProperties.Name="Settings" Content="⚙" FontSize="15"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="Settings"
                            Click="SettingsButton_Click" />
                    <Button x:Name="MinimiseButton" AutomationProperties.Name="Minimise" Content="—"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="Minimise"
                            Click="MinimiseButton_Click" />
                    <Button x:Name="MaximiseButton" AutomationProperties.Name="Maximise" Content="□" FontSize="15"
                            Style="{StaticResource CaptionButton}"
                            ToolTip="Maximise"
                            Click="MaximiseButton_Click" />
                    <Button x:Name="CloseButton" AutomationProperties.Name="Close" Content="✕"
                            Style="{StaticResource CloseCaptionButton}"
                            ToolTip="Close"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Stage rail -->
            <Border Grid.Column="0" Style="{StaticResource RivetedPanel}" Padding="18,20">
                <StackPanel>
                    <TextBlock Text="Sequence" Style="{StaticResource PlateLabelText}" Margin="0,0,0,18" />

                    <StackPanel x:Name="StageRail">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Tag="0">
                            <Ellipse x:Name="Lamp0" Style="{StaticResource StageLamp}" />
                            <TextBlock x:Name="Label0" Text="Read the disc" Style="{StaticResource StageLabel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Tag="1">
                            <Ellipse x:Name="Lamp1" Style="{StaticResource StageLamp}" />
                            <TextBlock x:Name="Label1" Text="Identify release" Style="{StaticResource StageLabel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Tag="2">
                            <Ellipse x:Name="Lamp2" Style="{StaticResource StageLamp}" />
                            <TextBlock x:Name="Label2" Text="Rip to FLAC" Style="{StaticResource StageLabel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Tag="3">
                            <Ellipse x:Name="Lamp3" Style="{StaticResource StageLamp}" />
                            <TextBlock x:Name="Label3" Text="Cover art" Style="{StaticResource StageLabel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Tag="4">
                            <Ellipse x:Name="Lamp4" Style="{StaticResource StageLamp}" />
                            <TextBlock x:Name="Label4" Text="Verify and upload" Style="{StaticResource StageLabel}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{StaticResource BrassDarkBrush}" Opacity="0.5" Margin="0,10,0,18" />

                    <!-- Collected tracks so far, so a multi-disc set shows its progress. -->
                    <TextBlock Text="Collected" Style="{StaticResource PlateLabelText}" Margin="0,0,0,10" />
                    <Border Style="{StaticResource RecessedPanel}" Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="CollectedTracksText" Style="{StaticResource ReadoutText}" Text="0 tracks" />
                            <TextBlock x:Name="CollectedDiscsText" Style="{StaticResource DimText}"
                                       Text="no discs ripped" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="OutputFolderButton" Content="Open Folder"
                            Style="{StaticResource BrassButton}"
                            Margin="0,18,0,0" MinWidth="0" Padding="12,7"
                            IsEnabled="False"
                            Click="OutputFolderButton_Click" />
                </StackPanel>
            </Border>

            <!-- Step content -->
            <Border Grid.Column="1" Style="{StaticResource RivetedPanel}" Margin="16,0,0,0" Padding="24">
                <Grid>

                    <!-- ===== Step 0: disc ===== -->
                    <Grid x:Name="StepDisc" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Read the disc" Style="{StaticResource PanelTitleText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Text="Choose the drive holding the first disc of the set. The table of contents is read first so the release can be matched against the physical disc, not just its title." />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Optical drive" Style="{StaticResource PlateLabelText}" Margin="0,0,0,7" />
                                <ComboBox x:Name="DriveCombo"
                                          Style="{StaticResource PanelComboBox}"
                                          ItemContainerStyle="{StaticResource PanelComboBoxItem}" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="RefreshDrivesButton" Content="Refresh"
                                    Style="{StaticResource BrassButton}"
                                    VerticalAlignment="Bottom" Margin="10,0,0,0" MinWidth="0" Padding="14,8"
                                    Click="RefreshDrivesButton_Click" />

                            <Button Grid.Column="2" x:Name="ReadDiscButton" Content="Read Disc"
                                    Style="{StaticResource AmberButton}"
                                    VerticalAlignment="Bottom" Margin="10,0,0,0"
                                    Click="ReadDiscButton_Click" />
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource RecessedPanel}" Margin="0,20,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DiscReadoutText"
                                           Style="{StaticResource ReadoutText}"
                                           Text="Awaiting disc..."
                                           LineHeight="20" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ===== Step 1: identify ===== -->
                    <Grid x:Name="StepIdentify" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Identify release" Style="{StaticResource PanelTitleText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Text="Matches marked VERIFIED have a track count that agrees with this disc. An expanded edition shares its title with the original album, so an unverified match may well be the wrong release." />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource PanelTextBox}"
                                     KeyDown="SearchBox_KeyDown" />
                            <Button Grid.Column="1" x:Name="SearchButton" Content="Search"
                                    Style="{StaticResource BrassButton}"
                                    Margin="10,0,0,0" MinWidth="0" Padding="16,8"
                                    Click="SearchButton_Click" />
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource RecessedPanel}" Margin="0,14,0,0" Padding="4">
                            <ListView x:Name="MatchList"
                                      Style="{StaticResource PanelListView}"
                                      ItemContainerStyle="{StaticResource PanelListViewItem}"
                                      SelectionChanged="MatchList_SelectionChanged">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource PanelGridViewHeader}">
                                        <GridViewColumn Header="Status" Width="92"
                                                        DisplayMemberBinding="{Binding StatusText}" />
                                        <GridViewColumn Header="Release" Width="330"
                                                        DisplayMemberBinding="{Binding Title}" />
                                        <GridViewColumn Header="Artist" Width="190"
                                                        DisplayMemberBinding="{Binding Artist}" />
                                        <GridViewColumn Header="Year" Width="60"
                                                        DisplayMemberBinding="{Binding YearText}" />
                                        <GridViewColumn Header="Tracks" Width="66"
                                                        DisplayMemberBinding="{Binding TrackCountText}" />
                                        <GridViewColumn Header="Source" Width="120"
                                                        DisplayMemberBinding="{Binding Source}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <!-- Album fields stay editable: no source gets a limited pressing perfectly right. -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Album title" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Album artist" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Year" Style="{StaticResource PlateLabelText}" Margin="0,0,0,6" />

                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="AlbumTitleBox" Style="{StaticResource PanelTextBox}" />
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="AlbumArtistBox" Style="{StaticResource PanelTextBox}" />
                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="YearBox" Style="{StaticResource PanelTextBox}" />

                            <Button Grid.Row="1" Grid.Column="6" x:Name="StartRipButton" Content="Start Rip"
                                    Style="{StaticResource AmberButton}"
                                    Click="StartRipButton_Click" />
                        </Grid>
                    </Grid>

                    <!-- ===== Step 2: rip ===== -->
                    <Grid x:Name="StepRip" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="RipHeadingText" Text="Ripping disc 1" Style="{StaticResource PanelTitleText}" />
                            <TextBlock x:Name="RipSubText" Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Text="Reading audio with offset correction and re-reads on damaged sectors. Encoding straight to FLAC." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,22,0,0">
                            <Grid Margin="0,0,0,7">
                                <TextBlock x:Name="RipTrackLabel" Style="{StaticResource ReadoutText}" Text="Ready" />
                                <TextBlock x:Name="RipTrackPercent" Style="{StaticResource ReadoutText}"
                                           Text="0%" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="RipTrackProgress" Style="{StaticResource GaugeBar}" Minimum="0" Maximum="100" />

                            <Grid Margin="0,18,0,7">
                                <TextBlock Text="Disc total" Style="{StaticResource PlateLabelText}" />
                                <TextBlock x:Name="RipOverallPercent" Style="{StaticResource ReadoutText}"
                                           Text="0%" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="RipOverallProgress" Style="{StaticResource GaugeBar}" Height="26" Minimum="0" Maximum="100" />
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource RecessedPanel}" Margin="0,20,0,0">
                            <ScrollViewer x:Name="RipLogScroller" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="RipLogText" Style="{StaticResource ReadoutText}"
                                           FontSize="12" LineHeight="18" />
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="CancelRipButton" Content="Cancel"
                                    Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                                    Click="CancelRipButton_Click" />
                            <Button x:Name="NextDiscButton" Content="Rip Another Disc"
                                    Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                                    Visibility="Collapsed"
                                    Click="NextDiscButton_Click" />
                            <Button x:Name="ToArtworkButton" Content="Continue to Artwork"
                                    Style="{StaticResource AmberButton}"
                                    Visibility="Collapsed"
                                    Click="ToArtworkButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Step 3: artwork ===== -->
                    <Grid x:Name="StepArtwork" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Cover art" Style="{StaticResource PanelTitleText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Text="Limited soundtrack pressings are poorly covered online. Several sources are searched at once; if none of them has the right cover, save the artwork yourself and choose the file." />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource RecessedPanel}" Margin="0,20,0,0">
                            <Grid>
                                <StackPanel x:Name="ArtworkIdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ArtworkStatusText" Style="{StaticResource ReadoutText}"
                                               Text="No artwork selected" HorizontalAlignment="Center" />
                                    <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               Text="Search the online sources, or choose a file you have already saved." />
                                </StackPanel>

                                <StackPanel x:Name="ArtworkPreviewPanel" Visibility="Collapsed"
                                            Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border BorderBrush="{StaticResource BrassEdgeBrush}" BorderThickness="2" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.8" />
                                        </Border.Effect>
                                        <Image x:Name="ArtworkPreviewImage" Width="240" Height="240" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ArtworkSourceText" Style="{StaticResource ReadoutText}" Text="" />
                                        <TextBlock x:Name="ArtworkResolutionText" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                        <TextBlock x:Name="ArtworkQualityText" Style="{StaticResource DimText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button x:Name="SearchArtworkButton" Content="Search Online"
                                    Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                                    Click="SearchArtworkButton_Click" />
                            <Button x:Name="ChooseArtworkButton" Content="Choose File"
                                    Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                                    Click="ChooseArtworkButton_Click" />
                            <Button x:Name="ApplyArtworkButton" Content="Apply and Verify"
                                    Style="{StaticResource AmberButton}"
                                    IsEnabled="False"
                                    Click="ApplyArtworkButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Step 4: verify ===== -->
                    <Grid x:Name="StepVerify" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Verify and upload" Style="{StaticResource PanelTitleText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Text="Every file is re-read from disk and checked against what YouTube Music needs to treat the set as one album." />
                        </StackPanel>

                        <!-- The verdict lamp: green all clear, red faults. -->
                        <Border Grid.Row="1" Style="{StaticResource RecessedPanel}" Margin="0,18,0,0" Padding="18,14">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="34" Height="34" VerticalAlignment="Center">
                                    <Ellipse x:Name="VerdictBezel" Stroke="{StaticResource BrassEdgeBrush}" StrokeThickness="2.5" Fill="{StaticResource RecessBrush}" />
                                    <Ellipse x:Name="VerdictLamp" Width="17" Height="17" Fill="#1A1512" />
                                </Grid>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="VerdictText" Style="{StaticResource ReadoutText}" Text="Not yet checked" />
                                    <TextBlock x:Name="VerdictDetailText" Style="{StaticResource DimText}" Margin="0,4,0,0" Text="" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource RecessedPanel}" Margin="0,14,0,0" Padding="4">
                            <ListView x:Name="IssueList"
                                      Style="{StaticResource PanelListView}"
                                      ItemContainerStyle="{StaticResource PanelListViewItem}">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource PanelGridViewHeader}">
                                        <GridViewColumn Header="Level" Width="90" DisplayMemberBinding="{Binding SeverityText}" />
                                        <GridViewColumn Header="Track" Width="64" DisplayMemberBinding="{Binding TrackText}" />
                                        <GridViewColumn Header="Finding" Width="700" DisplayMemberBinding="{Binding Message}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="RecheckButton" Content="Re-check"
                                    Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                                    Click="RecheckButton_Click" />
                            <Button x:Name="ManualEditButton" Content="Edit Tags"
                                    Style="{StaticResource BrassButton}" Margin="0,0,10,0"
                                    Click="ManualEditButton_Click" />
                            <Button x:Name="UploadButton" Content="Commence Upload"
                                    Style="{StaticResource AmberButton}"
                                    IsEnabled="False"
                                    Click="UploadButton_Click" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Style="{StaticResource RecessedPanel}" Margin="0,16,0,0" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- A live lamp, so the panel always looks powered. -->
                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{StaticResource LampGreenBrush}" Opacity="0.85">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="{StaticResource LampGreenColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock Grid.Column="1" x:Name="StatusText" Style="{StaticResource BodyText}"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="Ready." />

                <TextBlock Grid.Column="2" Style="{StaticResource DimText}" VerticalAlignment="Center"
                           Text="FLAC  ·  flattened to one disc  ·  C:\Users\markl\Music" />
            </Grid>
        </Border>
    </Grid>
  </Border>
</local:PanelWindow>
