<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!--
        ClaudeSoundtrack visual language.

        Drawn from the reference photographs: an oxidised steel control panel with
        brass fittings, warm amber lamps and red indicator bulbs, shot in low light.
        The rules that keep it coherent:

          - Ground everything in near-black steel. The panels are dark; the brass
            and the lamps are what carry the eye.
          - Brass is for structure - borders, rivets, frames. Amber is for state -
            anything lit means something is active.
          - Red is reserved for genuine problems. Overusing it costs the warning
            all of its force, exactly as it would on a real panel.
          - Text is aged parchment, never pure white, which would read as modern
            and flat against these materials.
    -->

    <!-- ===== Palette ===== -->

    <!-- Steel: the panel body, darkest at the edges. -->
    <Color x:Key="SteelDarkestColor">#0F0C0A</Color>
    <Color x:Key="SteelDarkColor">#1A1512</Color>
    <Color x:Key="SteelColor">#241D18</Color>
    <Color x:Key="SteelLightColor">#332A22</Color>
    <Color x:Key="SteelHighlightColor">#453A2E</Color>

    <!-- Brass: fittings and frames. -->
    <Color x:Key="BrassDarkColor">#6B5320</Color>
    <Color x:Key="BrassColor">#A8822C</Color>
    <Color x:Key="BrassLightColor">#D4AF47</Color>
    <Color x:Key="BrassPaleColor">#E8CE86</Color>

    <!-- Copper: secondary trim, pipework. -->
    <Color x:Key="CopperColor">#B87333</Color>
    <Color x:Key="CopperDarkColor">#7A4A1E</Color>

    <!-- Amber: lamps and anything currently active. -->
    <Color x:Key="AmberColor">#FFA62B</Color>
    <Color x:Key="AmberBrightColor">#FFD08A</Color>
    <Color x:Key="AmberDimColor">#8A5A18</Color>

    <!-- Indicator red: faults only. -->
    <Color x:Key="LampRedColor">#E03A2F</Color>
    <Color x:Key="LampRedDarkColor">#5E1A14</Color>

    <!-- Verdigris green: the "all clear" lamp. -->
    <Color x:Key="LampGreenColor">#5FA860</Color>
    <Color x:Key="LampGreenDarkColor">#22401F</Color>

    <!-- Parchment: text. -->
    <Color x:Key="ParchmentColor">#E8D9B0</Color>
    <Color x:Key="ParchmentDimColor">#A89878</Color>
    <Color x:Key="ParchmentFaintColor">#6E6250</Color>

    <!-- ===== Brushes ===== -->

    <SolidColorBrush x:Key="SteelDarkestBrush" Color="{StaticResource SteelDarkestColor}" />
    <SolidColorBrush x:Key="SteelDarkBrush" Color="{StaticResource SteelDarkColor}" />
    <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource SteelColor}" />
    <SolidColorBrush x:Key="SteelLightBrush" Color="{StaticResource SteelLightColor}" />
    <SolidColorBrush x:Key="SteelHighlightBrush" Color="{StaticResource SteelHighlightColor}" />

    <SolidColorBrush x:Key="BrassDarkBrush" Color="{StaticResource BrassDarkColor}" />
    <SolidColorBrush x:Key="BrassBrush" Color="{StaticResource BrassColor}" />
    <SolidColorBrush x:Key="BrassLightBrush" Color="{StaticResource BrassLightColor}" />
    <SolidColorBrush x:Key="BrassPaleBrush" Color="{StaticResource BrassPaleColor}" />
    <SolidColorBrush x:Key="CopperBrush" Color="{StaticResource CopperColor}" />

    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberBrightBrush" Color="{StaticResource AmberBrightColor}" />
    <SolidColorBrush x:Key="AmberDimBrush" Color="{StaticResource AmberDimColor}" />
    <SolidColorBrush x:Key="LampRedBrush" Color="{StaticResource LampRedColor}" />
    <SolidColorBrush x:Key="LampGreenBrush" Color="{StaticResource LampGreenColor}" />

    <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource ParchmentColor}" />
    <SolidColorBrush x:Key="ParchmentDimBrush" Color="{StaticResource ParchmentDimColor}" />
    <SolidColorBrush x:Key="ParchmentFaintBrush" Color="{StaticResource ParchmentFaintColor}" />

    <!-- The panel face: lit slightly from above, as the reference photographs are. -->
    <LinearGradientBrush x:Key="PanelFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource SteelLightColor}" Offset="0" />
        <GradientStop Color="{StaticResource SteelColor}" Offset="0.35" />
        <GradientStop Color="{StaticResource SteelDarkColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- The window ground, darkened at the corners like an unlit workshop. -->
    <RadialGradientBrush x:Key="WorkshopBrush" GradientOrigin="0.5,0.25" Center="0.5,0.3" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="{StaticResource SteelColor}" Offset="0" />
        <GradientStop Color="{StaticResource SteelDarkColor}" Offset="0.55" />
        <GradientStop Color="{StaticResource SteelDarkestColor}" Offset="1" />
    </RadialGradientBrush>

    <!-- Polished brass, with the bright band a curved metal edge catches. -->
    <LinearGradientBrush x:Key="BrassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BrassPaleColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrassColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource BrassDarkColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- A brass control at rest. -->
    <LinearGradientBrush x:Key="BrassButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A3D22" Offset="0" />
        <GradientStop Color="#38301C" Offset="0.5" />
        <GradientStop Color="#2A2416" Offset="1" />
    </LinearGradientBrush>

    <!-- The same control lit, when hovered. -->
    <LinearGradientBrush x:Key="BrassButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6E5A2E" Offset="0" />
        <GradientStop Color="#544523" Offset="0.5" />
        <GradientStop Color="#3E3520" Offset="1" />
    </LinearGradientBrush>

    <!-- The primary action, unmistakably the lit switch on the panel. -->
    <LinearGradientBrush x:Key="AmberButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C9821F" Offset="0" />
        <GradientStop Color="#A16714" Offset="0.5" />
        <GradientStop Color="#7A4C0E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFB84D" Offset="0" />
        <GradientStop Color="#D48A20" Offset="0.5" />
        <GradientStop Color="#9C6212" Offset="1" />
    </LinearGradientBrush>

    <!-- A recessed readout, as though sunk into the panel. -->
    <LinearGradientBrush x:Key="RecessBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A0806" Offset="0" />
        <GradientStop Color="#12100C" Offset="0.4" />
        <GradientStop Color="#1A1712" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Typography ===== -->

    <!--
        Cinzel is a Roman-inscription face that suits engraved brass nameplates.
        It is not installed by default, so every reference falls back through
        Georgia to a generic serif rather than dropping to Segoe UI.
    -->
    <FontFamily x:Key="DisplayFont">Cinzel, Georgia, Times New Roman, serif</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI, Tahoma, sans-serif</FontFamily>
    <!-- Instrument readouts are monospaced so digits do not shuffle as they change. -->
    <FontFamily x:Key="ReadoutFont">Consolas, Courier New, monospace</FontFamily>

    <!-- ===== Text styles ===== -->

    <Style x:Key="PanelTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrassPaleBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Effect">
            <Setter.Value>
                <!-- Engraved brass catches a faint warm glow. -->
                <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlateLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrassLightBrush}" />
        <!--
            Small caps reads as a stamped nameplate. WPF has no letter-spacing
            property, so the typographic variant carries that job instead; on a
            fallback face without small caps it degrades to plain caps, which is
            still correct for a label.
        -->
        <Setter Property="Typography.Capitals" Value="SmallCaps" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource ParchmentDimBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ReadoutText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ReadoutFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Rivet ===== -->

    <!--
        A single rivet head. Reused at the corners of every panel; it is the
        detail that makes the surfaces read as bolted plate rather than boxes.
    -->
    <Style x:Key="Rivet" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill">
            <Setter.Value>
                <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="{StaticResource BrassPaleColor}" Offset="0" />
                    <GradientStop Color="{StaticResource BrassColor}" Offset="0.55" />
                    <GradientStop Color="#3A2E14" Offset="1" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Stroke" Value="#1A1510" />
        <Setter Property="StrokeThickness" Value="0.75" />
    </Style>

    <!-- ===== Panel ===== -->

    <!--
        The base surface everything sits on: a brass-framed steel plate with a
        drop shadow, so panels layer visibly instead of sitting flat.
    -->
    <Style x:Key="RivetedPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelFaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.7" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A recessed well for readouts and lists. -->
    <Style x:Key="RecessedPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RecessBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassDarkBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- ===== Buttons ===== -->

    <Style x:Key="BrassButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrassButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{StaticResource BrassPaleBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Plate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <!-- A thin bright line along the top edge, as machined metal has. -->
                        <Border x:Name="Sheen"
                                Height="1"
                                Margin="4,1,4,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource BrassPaleBrush}"
                                Opacity="0.35" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource BrassButtonHoverBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource BrassLightBrush}" />
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <!-- Pressed reads as the control sinking into the panel. -->
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource RecessBrush}" />
                            <Setter TargetName="Sheen" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource AmberBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                            <Setter Property="Foreground" Value="{StaticResource ParchmentFaintBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The lit primary action. One per screen, so it is never ambiguous. -->
    <Style x:Key="AmberButton" TargetType="Button" BasedOn="{StaticResource BrassButton}">
        <Setter Property="Background" Value="{StaticResource AmberButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrightBrush}" />
        <Setter Property="Foreground" Value="#2A1B06" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AmberButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <!-- An unlit lamp: the glow must go, or disabled still looks live. -->
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Caption buttons ===== -->

    <!--
        Minimise / maximise / close for the borderless panel. Deliberately flat
        and unlit: they are window furniture, not panel controls, and giving them
        the brass treatment would make them compete with the actual switches.
        Close is the only one that lights, and only on hover, in fault red.
    -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ParchmentDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Without this the chrome treats them as caption and drags the window. -->
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SteelHighlightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrassPaleBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource RecessBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The outer edge of the chassis. With no Windows frame the panel supplies
        its own, or it floats shapelessly against whatever is behind it.
    -->
    <Style x:Key="ChassisEdge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WorkshopBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ===== Text input ===== -->

    <Style x:Key="PanelTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource RecessBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassDarkBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{StaticResource AmberBrightBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AmberBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrassBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Well"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Well" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->

    <Style x:Key="PanelComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource RecessBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassDarkBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{StaticResource AmberBrightBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{StaticResource RecessBrush}"
                                            BorderBrush="{StaticResource BrassDarkBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <!-- A brass thumb-wheel rather than a chevron. -->
                                            <Border Grid.Column="1"
                                                    Margin="3"
                                                    CornerRadius="2"
                                                    Background="{StaticResource BrassEdgeBrush}"
                                                    Opacity="0.85">
                                                <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                                      Fill="#2A1B06"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="8,0,32,0"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource SteelDarkBrush}"
                                    BorderBrush="{StaticResource BrassBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="3"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.8" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SteelHighlightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AmberBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Progress ===== -->

    <!--
        A pressure gauge rather than a progress bar: an amber bar rising in a
        recessed well, with a bright leading edge like a lit filament.
    -->
    <Style x:Key="GaugeBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
        <Setter Property="Background" Value="{StaticResource RecessBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrassDarkBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{StaticResource AmberBrightColor}" Offset="0" />
                                        <GradientStop Color="{StaticResource AmberColor}" Offset="0.45" />
                                        <GradientStop Color="{StaticResource AmberDimColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.65" />
                                </Rectangle.Effect>
                            </Rectangle>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbar ===== -->

    <!-- A brass slide rail; the default chrome scrollbar breaks the illusion badly. -->
    <Style x:Key="PanelScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="#0C0A08">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BrassEdgeBrush}"
                                                    CornerRadius="5"
                                                    Margin="2"
                                                    Opacity="0.75" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <!-- Repeat buttons are present but invisible: the rail is the affordance. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--
                Horizontal bars need the track laid out along the other axis, the
                commands swapped, and the direction un-reversed - otherwise a wide
                table's scrollbar drags backwards.
            -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="#0C0A08">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{StaticResource BrassEdgeBrush}"
                                                            CornerRadius="5"
                                                            Margin="2"
                                                            Opacity="0.75" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Applied to every scrollbar in the app: the default chrome scrollbar is a
         bright grey slab that breaks the illusion wherever a list overflows. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PanelScrollBar}" />

    <!-- ===== Slider ===== -->

    <!--
        A brass thumb running in a recessed rail, like a fader on the panel.
        The lit portion of the rail shows the current value, so the control reads
        at a glance without a numeric label.
    -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Rail -->
                        <Border Height="7" VerticalAlignment="Center"
                                Background="{StaticResource RecessBrush}"
                                BorderBrush="{StaticResource BrassDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="3" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- The travelled part of the rail, lit. -->
                                            <Grid Background="Transparent">
                                                <Border Height="5" VerticalAlignment="Center"
                                                        Margin="1,0,0,0"
                                                        CornerRadius="2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="{StaticResource AmberBrightColor}" Offset="0" />
                                                            <GradientStop Color="{StaticResource AmberColor}" Offset="0.5" />
                                                            <GradientStop Color="{StaticResource AmberDimColor}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="{StaticResource AmberColor}"
                                                                          BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- Transparent, but must still take clicks so
                                                 clicking the rail pages the value. -->
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb x:Name="Grip" Width="16" Height="22">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border Background="{StaticResource BrassEdgeBrush}"
                                                        BorderBrush="#2A2214"
                                                        BorderThickness="1"
                                                        CornerRadius="3" />
                                                <!-- Knurling, so it reads as something to grip. -->
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle Width="1" Height="10" Fill="#3A2E14" Margin="1,0" Opacity="0.8" />
                                                    <Rectangle Width="1" Height="10" Fill="#3A2E14" Margin="1,0" Opacity="0.8" />
                                                    <Rectangle Width="1" Height="10" Fill="#3A2E14" Margin="1,0" Opacity="0.8" />
                                                </StackPanel>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== List ===== -->

    <Style x:Key="PanelListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="PanelListViewItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Row"
                            Background="Transparent"
                            BorderBrush="#241D18"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#2A231C" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <!-- Selection is a lit row, matching the amber = active rule. -->
                            <Setter TargetName="Row" Property="Background" Value="#4A3A18" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AmberBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelGridViewHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrassButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrassPaleBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrassDarkBrush}"
                            BorderThickness="0,0,1,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->

    <Style x:Key="PanelCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <!-- A brass-bezelled indicator lamp that lights when set. -->
                        <Border Width="18" Height="18"
                                CornerRadius="9"
                                Background="{StaticResource RecessBrush}"
                                BorderBrush="{StaticResource BrassBrush}"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Lamp" Width="8" Height="8" Fill="{StaticResource AmberBrush}" Opacity="0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lamp" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
